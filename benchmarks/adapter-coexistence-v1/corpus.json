      "adapter": "html",
      "tailwindProfile": "tailwind-v3-lts",
      "title": "Build metrics",
      "viewport": { "width": 1280, "height": 800 },
      "body": "<main aria-labelledby=\"metrics-title\" class=\"mx-auto flex max-w-6xl flex-col gap-12 px-4 py-12 sm:px-6 lg:px-8\"><h1 id=\"metrics-title\" class=\"text-2xl font-semibold tracking-tight text-ink\">Build metrics</h1><section aria-label=\"Compilation metrics\" class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-4\"><article class=\"rounded-xl border border-line bg-surface p-5 shadow-sm\"><p class=\"text-sm font-medium text-muted\">Build time</p><p class=\"mt-2 text-3xl font-bold tracking-tight text-ink\">12 ms</p></article><article class=\"rounded-xl border border-line bg-surface p-5 shadow-sm\"><p class=\"text-sm font-medium text-muted\">CSS gzip</p><p class=\"mt-2 text-3xl font-bold tracking-tight text-ink\">4.2 KB</p></article></section></main>"
