      "body": "<header class=\"mx-auto flex max-w-6xl flex-col gap-12 px-4 py-12 sm:px-6 lg:px-8\"><nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-4 border-b border-line pb-4 md:flex-row md:items-center md:justify-between\"><a class=\"text-lg font-bold tracking-tight text-ink\" href=\"#home\">PliegoCSS</a><div class=\"flex flex-wrap items-center gap-2\"><a class=\"rounded-md px-3 py-2 text-sm font-medium text-muted hover:bg-surface-raised hover:text-ink\" href=\"#docs\">Docs</a><a class=\"rounded-md px-3 py-2 text-sm font-medium text-muted hover:bg-surface-raised hover:text-ink\" href=\"#examples\">Examples</a><a class=\"rounded-md bg-ink px-3 py-2 text-sm font-semibold text-white hover:opacity-90\" href=\"#start\">Start</a></div></nav></header>"
