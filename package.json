{
  "name": "pliegocss-baseline",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "baseline:build": "tailwindcss -i ./benchmarks/tailwind-v4/input.css -o ./benchmarks/tailwind-v4/dist/full-complete.min.css --minify",
    "baseline:watch": "tailwindcss -i ./benchmarks/tailwind-v4/input.css -o ./benchmarks/tailwind-v4/dist/full-complete.min.css --watch",
    "baseline:measure": "node ./scripts/measure-tailwind-baseline.mjs",
    "baseline:measure-watch": "node ./scripts/measure-tailwind-watch.mjs",
    "baseline:measure-rust": "node ./scripts/measure-rust-check.mjs",
    "baseline:measure-pliego": "node ./scripts/measure-pliego-gate-a.mjs",
    "baseline:measure-pliego-b": "node ./scripts/measure-pliego-gate-b.mjs",
    "baseline:measure-media": "node ./scripts/measure-media-merge.mjs",
    "baseline:measure-wasm": "node ./scripts/measure-wasm-overhead.mjs",
    "baseline:check-diagnostics": "node ./scripts/check-diagnostics.mjs",
    "check:api": "node ./scripts/check-public-api.mjs && pnpm check:manifest && pnpm check:trace",
    "check:determinism": "node ./scripts/check-parallel-determinism.mjs",
    "check:properties": "cargo +1.85.0 test --locked -p pliego-css-compiler --test property_contract",
    "check:fuzz": "node ./scripts/check-fuzz.mjs",
    "soak:fuzz": "node ./scripts/check-fuzz.mjs --seconds 300",
    "check:manifest": "node ./scripts/check-manifest-graph.mjs",
    "check:trace": "node ./scripts/check-physical-trace.mjs",
    "check:media": "node ./scripts/measure-media-merge.mjs --check",
    "check:pruning": "node ./scripts/measure-reachability-pruning.mjs --check",
    "check:evidence": "node ./scripts/check-benchmark-evidence.mjs",
    "check:portability": "cargo build --locked -p pliego-cssc && node ./scripts/check-portability.mjs",
    "check:compatibility": "node ./scripts/check-compatibility-policy.mjs",
    "check:attribution": "node ./scripts/check-standards-provenance.mjs",
    "check:docs": "node ./scripts/check-docs.mjs",
    "check:maturity": "node ./scripts/check-maturity-map.mjs",
    "check:tailwind-matrix": "node ./scripts/check-tailwind-matrix.mjs",
    "check:representative-gaps": "node ./scripts/check-representative-gap-map.mjs",
    "check:css-classifier": "node ./scripts/check-standard-css-classifier-corpus.mjs",
    "check:hosted-browser-matrix": "node ./scripts/check-hosted-browser-matrix.mjs",
    "integration:browser:chrome": "node ./scripts/check-local-cdp-browser.mjs \"C:/Program Files/Google/Chrome/Application/chrome.exe\"",
    "integration:browser:edge": "node ./scripts/check-local-cdp-browser.mjs \"C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe\"",
    "integration:browser:theme-root:chrome": "node ./scripts/check-theme-root-browser.mjs \"C:/Program Files/Google/Chrome/Application/chrome.exe\"",
    "integration:browser:theme-root:edge": "node ./scripts/check-theme-root-browser.mjs \"C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe\"",
    "integration:browser:utility:chrome": "node ./scripts/check-utility-projection-browser.mjs \"C:/Program Files/Google/Chrome/Application/chrome.exe\"",
    "integration:browser:utility:edge": "node ./scripts/check-utility-projection-browser.mjs \"C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe\"",
    "integration:browser:template-group:chrome": "node ./scripts/check-template-group-browser.mjs \"C:/Program Files/Google/Chrome/Application/chrome.exe\"",
    "integration:browser:template-group:edge": "node ./scripts/check-template-group-browser.mjs \"C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe\"",
    "check:getting-started": "node ./scripts/check-getting-started.mjs",
    "check:release-contract": "node ./scripts/check-release.test.mjs",
    "verify:fast": "node ./scripts/check-release.mjs fast",
    "verify:integration": "node ./scripts/check-release.mjs integration",
    "verify:release": "node ./scripts/check-release.mjs release",
    "check:cascade": "cargo test --locked -p pliego-css-cascade --lib && cargo test --locked -p pliego-cssc --test cascade_explain",
    "check:agent": "cargo test --locked -p pliego-css-agent --all-targets && cargo test --locked -p pliego-cssc --test repair_plan",
    "check:repair-corpus": "node ./scripts/check-repair-corpus.mjs",
    "check:migration-corpus": "node ./scripts/check-migration-corpus.mjs",
    "check:migration-real-corpus": "node ./scripts/check-migration-real-corpus.mjs",
    "check:accessibility-quality": "cargo test -p pliego-css-control --features projection --test accessibility_quality --locked",
    "check:pliegors-guide": "node ./scripts/check-pliegors-guide.mjs",
    "check:packages": "node ./scripts/check-packages.mjs",
    "integration:plain-html": "node ./scripts/check-plain-html-integration.mjs",
    "integration:representative:plain-html-audit": "node ./scripts/check-representative-plain-html-audit.mjs",
    "integration:representative:vite-tailwind": "node ./scripts/check-representative-vite-tailwind.mjs",
    "integration:representative:vite-tailwind-reversible": "node ./scripts/check-representative-vite-tailwind-reversible.mjs",
    "integration:representative:vite-tailwind-replacement": "node ./scripts/check-representative-vite-tailwind-replacement.mjs",
    "integration:representative:vite-tailwind-utility": "node ./scripts/check-representative-vite-tailwind-utility.mjs",
    "integration:representative:vite-tailwind-template-group": "node ./scripts/check-representative-vite-tailwind-template-group.mjs",
    "integration:representative:css-modules": "node ./scripts/check-representative-css-modules.mjs",
    "integration:representative:rust-control": "node ./scripts/check-representative-rust-control.mjs",
    "integration:representative:framework-routes": "node ./scripts/check-representative-framework-routes.mjs",
    "integration:lsp": "node ./scripts/check-lsp-integration.mjs",
    "integration:vscode": "node ./scripts/check-vscode-client.mjs",
    "integration:vscode-host": "pnpm --filter pliegocss-vscode test:host",
    "integration:neovim": "node ./scripts/check-neovim-client.mjs",
    "integration:pliegors": "node ./scripts/check-pliegors-integration.mjs",
    "integration:pliegors-browser": "node ./scripts/check-pliegors-browser.mjs",
    "integration:pliegors-dev": "node ./scripts/check-pliegors-dev-loop.mjs",
    "bench:migration-adoption": "node ./scripts/measure-migration-adoption.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.2",
    "tailwindcss": "4.3.2"
  }
}
