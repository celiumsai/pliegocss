{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "carbon": {
      "950": { "$type": "color", "$value": "#11151a" },
      "800": { "$type": "color", "$value": "#283039" },
      "600": { "$type": "color", "$value": "#59636d" }
    },
    "paper": {
      "50": { "$type": "color", "$value": "#f4f7f8" },
      "0": { "$type": "color", "$value": "#ffffff" }
    },
    "cobalt": {
      "600": { "$type": "color", "$value": "#2855ff" },
      "400": { "$type": "color", "$value": "#6f8cff" }
    },
    "cyan": {
      "400": { "$type": "color", "$value": "#65d9ff" }
    },
    "semantic": {
      "danger": { "$type": "color", "$value": "#ff5a47" },
      "warning": { "$type": "color", "$value": "#d99a20" }
    }
  },
  "dimension": {
    "grid": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "radius-control": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "radius-panel": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": ["Instrument Sans", "Arial Narrow", "Arial", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": ["Instrument Sans", "Arial", "sans-serif"] },
    "code": { "$type": "fontFamily", "$value": ["Fragment Mono", "Consolas", "monospace"] }
  },
  "cubicBezier": {
    "fold": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] }
  }
}
