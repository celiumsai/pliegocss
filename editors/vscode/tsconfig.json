{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src/**/*.js",
    "tests/**/*.js",
    "scripts/**/*.mjs"
  ]
}
